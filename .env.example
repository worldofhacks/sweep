# Copy to .env (git-ignored) or symlink it to a 0600 file outside the checkout.
# Never put GitHub, GitLab, or other repository credentials here; they belong to
# the operator's git credential store, not to the Sweep runtime.

# Relay authentication. Generate each secret with: openssl rand -hex 32
SWEEP_RELAY_TOKEN=
# Per-aircraft credentials. The keys are stable positive drone IDs. Single-quote JSON
# values: `just relay` and `just fake-node` read this file with uv, which strips double
# quotes from unquoted values.
SWEEP_ADAPTER_KEYS_JSON='{}'
# Independent, per-aircraft localization-producer credentials. Empty is the safe
# default. Keys alone do not enable diagnostic pose projection; the host must also
# inject measured clock mappings, deployment/source pins, and bounded thresholds.
SWEEP_LOCALIZATION_KEYS_JSON='{}'
# Demo-only fallback: integrity without per-aircraft identity. Keep false for hardware.
SWEEP_ALLOW_SHARED_ADAPTER_TOKEN=false

# Relay persistence and bounded freshness policy.
SWEEP_SESSION_LOG_DIR=.sweep/session-logs
SWEEP_INTENT_MAX_AGE_MS=5000
SWEEP_TRANSPORT_EVENT_MAX_AGE_MS=5000
SWEEP_FUTURE_CLOCK_SKEW_MS=1000
SWEEP_TELEMETRY_FRESHNESS_MS=1000
# All accepted telemetry is retained. Only redundant state snapshots are sampled;
# the keepalive interval is bounded to 1..10000 ms. Per-aircraft state embeds only
# the newest 1..64 membership transitions (all transition events remain in replay).
SWEEP_AUDIT_STATE_INTERVAL_MS=10000
SWEEP_STATE_MEMBERSHIP_HISTORY=8

# Bridge: which adapter backend dispatch uses (sim or remote), and the thresholds the
# relay sends to every node in auth.accepted. Demo values; measure before hardware.
SWEEP_ADAPTER_BACKEND=sim
SWEEP_COMMAND_TTL_MS=2000
SWEEP_COMMAND_DEADLINE_MS=10000
SWEEP_VIRTUAL_STICK_HZ=10
SWEEP_NODE_WATCHDOG_HOLD_MS=2000
SWEEP_NODE_WATCHDOG_FAILSAFE_MS=10000

# Console-to-relay bootstrap. The token is served at runtime and is never built
# into the browser bundle or placed in a URL.
SWEEP_RELAY_ORIGIN=ws://127.0.0.1:8000
SWEEP_SESSION_ID=demo
# Explicit browser origins allowed to POST recorded audio to the relay.
SWEEP_CONSOLE_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MediaMTX has no anonymous account. Set its advertised LAN host, one derived
# publisher password per deployed node, and a separately generated reader password.
# See media/README.md; never copy a relay/control token into a media password.
SWEEP_MEDIA_HOST=127.0.0.1
SWEEP_MEDIA_DRONE1_PASSWORD=
SWEEP_MEDIA_DRONE2_PASSWORD=
SWEEP_MEDIA_DRONE3_PASSWORD=
SWEEP_MEDIA_DRONE4_PASSWORD=
SWEEP_MEDIA_WEBRTC_ORIGIN=http://127.0.0.1:8889
SWEEP_MEDIA_READ_USERNAME=sweep-reader
SWEEP_MEDIA_READ_PASSWORD=
# MediaMTX control API (loopback only) for the relay's per-aircraft video projection.
# Set the URL to http://127.0.0.1:9997 together with a password generated by
# `openssl rand -hex 32`; blank projects video from node claims alone.
SWEEP_MEDIA_API_URL=
SWEEP_MEDIA_API_USERNAME=sweep-api
SWEEP_MEDIA_API_PASSWORD=

# Autonomy composition (`just relay`, python -m relay.main): planner, arbiter, and sim
# camera values as JSON objects with exactly the config fields. These are the CI fixture
# values; measure and configure them before a hardware session.
SWEEP_PLANNING_JSON='{"takeoff_altitude_m":1.0,"translation_step_m":0.5,"altitude_step_m":null,"altitude_floor_z_m":null,"altitude_configuration_id":null,"altitude_completion_tolerance_m":null,"spacing_step_m":0.2,"flight_speed_m_s":0.5,"capture_yaw_speed_deg_s":30.0,"capture_yaw_tolerance_deg":1.0,"capture_pose_tolerance_m":0.1,"capture_min_overlap_deg":10.0,"capture_gimbal_pitch_deg":0.0,"reconstruct_headings_deg":[0,45,90,135,180,225,270,315],"translation_frame":"world"}'
SWEEP_SAFETY_JSON='{"geofence":{"min_x":-10.0,"max_x":10.0,"min_y":-10.0,"max_y":10.0,"min_z":0.0,"max_z":5.0},"ceiling_m":4.0,"min_spacing_m":0.8,"battery_reserve_fraction":0.2,"battery_critical_fraction":0.1,"battery_cost_per_m":0.01,"min_link_quality":0.4,"max_link_age_ms":1000,"min_position_quality":0.5,"max_position_age_ms":1000,"operator_timeout_ms":10000,"max_future_clock_skew_ms":1000,"min_capture_storage_bytes":1000000,"max_capture_pose_drift_m":0.2,"max_capture_gimbal_error_deg":1.0,"positioning_loss_hold_ms":3000,"motion_conflict_window_ms":500}'
# Required for the composed relay; operator_timeout_ms must be at least 3000.
SWEEP_OPERATOR_PRESENCE_WATCHDOG_JSON='{"action":"hold"}'
SWEEP_SIM_CAMERA_JSON='{"panorama_width_px":4096,"panorama_height_px":2048,"photo_width_px":1920,"photo_height_px":1080,"horizontal_fov_deg":60.0,"gimbal_pitch_min_deg":-90.0,"gimbal_pitch_max_deg":30.0,"storage_remaining_bytes":50000000,"initial_timestamp_ms":100000,"timestamp_step_ms":100}'

# Language and push-to-talk providers used by the backend only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Comma-separated Intent v1 names whose exact input-channel/intent pairs have
# completed qualification. Blank is fail-closed: speech may transcribe, clarify,
# and refuse, but it cannot produce an executable language plan.
SWEEP_QUALIFIED_VOICE_INTENTS=

# Optional language telemetry. Both keys are required to enable Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Leave blank for the Langfuse default host.
LANGFUSE_HOST=

# Total deadline for receiving a transcript upload, before decoding or provider I/O.
SWEEP_TRANSCRIPT_UPLOAD_TIMEOUT_MS=15000
