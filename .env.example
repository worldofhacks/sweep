# Copy to .env (git-ignored) or symlink it to a 0600 file outside the checkout.
# Never put GitHub, GitLab, or other repository credentials here; they belong to
# the operator's git credential store, not to the Sweep runtime.

# Relay authentication. Generate each secret with: openssl rand -hex 32
SWEEP_RELAY_TOKEN=
# Stable positive drone IDs mapped to distinct per-aircraft secrets.
SWEEP_ADAPTER_KEYS_JSON={}
# Demo-only fallback; leave false for hardware runs.
SWEEP_ALLOW_SHARED_ADAPTER_TOKEN=false

# Relay persistence and bounded freshness policy.
SWEEP_SESSION_LOG_DIR=.sweep/session-logs
SWEEP_INTENT_MAX_AGE_MS=5000
SWEEP_TRANSPORT_EVENT_MAX_AGE_MS=5000
SWEEP_FUTURE_CLOCK_SKEW_MS=1000
SWEEP_TELEMETRY_FRESHNESS_MS=1000
# Console-to-relay bootstrap. The token is served at runtime and is never built
# into the browser bundle or placed in a URL.
SWEEP_RELAY_ORIGIN=ws://127.0.0.1:8000
SWEEP_SESSION_ID=demo
# Explicit browser origins allowed to POST recorded audio to the relay.
SWEEP_CONSOLE_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authenticated MediaMTX playback. All three are required to enable playback.
SWEEP_MEDIA_WEBRTC_ORIGIN=http://127.0.0.1:8889
SWEEP_MEDIA_READ_USERNAME=
SWEEP_MEDIA_READ_PASSWORD=

# Language and push-to-talk providers used by the backend only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional language telemetry. Both keys are required to enable Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Leave blank for the Langfuse default host.
LANGFUSE_HOST=
