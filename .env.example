# Copy to .env (git-ignored) or symlink it to a 0600 file outside the checkout.
# Only the relay and the language module read these; nothing here reaches the console.
# Never put a GitHub, GitLab or other repository token in this file: those belong to
# the person or agent driving git, not to the running system.
# Generate the relay token with: openssl rand -hex 32
SWEEP_RELAY_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
WORLD_API_KEY=
