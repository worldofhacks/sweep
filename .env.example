# Copy to .env (git-ignored). Keys never reach the console; only the relay and the
# language module read them (PRD section 7.2).
# Generate the relay token with: openssl rand -hex 32
SWEEP_RELAY_TOKEN=
# Per-aircraft credentials. The keys are stable positive drone IDs.
SWEEP_ADAPTER_KEYS_JSON={}
# Demo-only fallback: integrity without per-aircraft identity. Keep false for hardware.
SWEEP_ALLOW_SHARED_ADAPTER_TOKEN=false
SWEEP_SESSION_LOG_DIR=.sweep/session-logs
# Demo freshness values. Measure and configure these before a hardware session.
SWEEP_INTENT_MAX_AGE_MS=5000
SWEEP_TRANSPORT_EVENT_MAX_AGE_MS=5000
SWEEP_FUTURE_CLOCK_SKEW_MS=1000
SWEEP_TELEMETRY_FRESHNESS_MS=1000
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
