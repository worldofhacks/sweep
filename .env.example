# Copy to .env (git-ignored). Relay, model, publish, and admin secrets stay server-side.
# The read-only media credential is provisioned to the local console at runtime.
# Generate the relay token with: openssl rand -hex 32
SWEEP_RELAY_TOKEN=
# Per-aircraft credentials. The keys are stable positive drone IDs.
SWEEP_ADAPTER_KEYS_JSON={}
# Demo-only fallback: integrity without per-aircraft identity. Keep false for hardware.
SWEEP_ALLOW_SHARED_ADAPTER_TOKEN=false
SWEEP_SESSION_LOG_DIR=.sweep/session-logs
# Demo freshness values. Measure and configure these before a hardware session.
SWEEP_INTENT_MAX_AGE_MS=5000
SWEEP_TRANSPORT_EVENT_MAX_AGE_MS=5000
SWEEP_FUTURE_CLOCK_SKEW_MS=1000
SWEEP_TELEMETRY_FRESHNESS_MS=1000
# MediaMTX rejects startup when these are absent. Generate independent values for every role.
SWEEP_MEDIA_PUBLISH_PASSWORD_DRONE_1=
SWEEP_MEDIA_PUBLISH_PASSWORD_DRONE_2=
SWEEP_MEDIA_PUBLISH_PASSWORD_DRONE_3=
SWEEP_MEDIA_PUBLISH_PASSWORD_DRONE_4=
SWEEP_MEDIA_PUBLISH_PASSWORD_DRONE_5=
SWEEP_MEDIA_PUBLISH_PASSWORD_DRONE_6=
SWEEP_MEDIA_READ_PASSWORD=
SWEEP_MEDIA_ADMIN_PASSWORD=
SWEEP_MEDIA_API_URL=http://127.0.0.1:9997
SWEEP_MEDIA_ADMIN_USERNAME=sweep-admin
SWEEP_MEDIA_STALE_AFTER_MS=1000
SWEEP_MEDIA_POLL_INTERVAL_MS=200
# The browser-visible console origin also controls MediaMTX WHEP and HLS CORS.
SWEEP_CONSOLE_ORIGIN=http://localhost:5173
SWEEP_CONSOLE_BIND_HOST=localhost
SWEEP_CONSOLE_PORT=5173
# Comma-separated ground-station addresses advertised to WebRTC clients.
SWEEP_MEDIA_WEBRTC_HOSTS=127.0.0.1
# Production default is 24h. Short test values are for isolated acceptance runs only.
SWEEP_MEDIA_RECORD_SEGMENT_DURATION=5s
SWEEP_MEDIA_RECORD_RETENTION=24h
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
