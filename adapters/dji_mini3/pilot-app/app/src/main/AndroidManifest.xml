<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- A connectedDevice foreground service needs one qualifying permission; this normal-level
         one covers the fake flavor, which has no USB accessory to hold. CHANGE_NETWORK_STATE
         also lets the service request the Wi-Fi transport for the relay socket. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Keep the relay link alive with the screen off; the user grants the exemption from Setup. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The relay socket (ws://) and the WHIP publish (http://) are plain-text on the flight-room LAN;
         the team deferred transport security with authentication. -->
    <application
        android:name=".BridgeApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SweepBridge">

        <!-- Landscape only: the pilot screen mirrors the RC-N1's landscape phone mount. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The relay link's foreground service (connectedDevice covers the USB-attached RC). -->
        <service
            android:name=".BridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.evidence"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/evidence_export_paths" />
        </provider>
    </application>
</manifest>
